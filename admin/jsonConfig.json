{
  "type": "tabs",
  "i18n": true,
  "tabsStyle": {
    "width": "calc(100% - 100px)"
  },
  "items": {
    "mainTab": {
      "type": "panel",
      "label": "Settings",
      "items": {
        "tvconfigs": {
          "type": "table",
          "label": "TV configurations",
          "xs": 12,
          "sm": 12,
          "md": 10,
          "lg": 8,
          "xl": 8,
          "allowAddByFilter": false,
          "uniqueColumns": ["name"],
          "newLine": true,
          "useCardFor": ["xs", "sm", "md", "lg", "xl"],
          "titleAttribute": "datapoint",
          "items": [
            {
              "type": "text",
              "attr": "datapoint",
              "readOnly": true,
              "title": "Data point",
              "defaultFunc": "''",
              "onChange": {
                "alsoDependsOn": ["name"],
                "calculateFunc": "data.datapoint || String(data.name || '').trim().toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').normalize('NFKD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]/g, '')"
              },
              "xs": 12,
              "sm": 6,
              "md": 8,
              "lg": 8,
              "xl": 8
            },
            {
              "type": "text",
              "attr": "name",
              "title": "TV name",
              "default": "",
              "validator": "const clean = value => String(value || '').trim().toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').normalize('NFKD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]/g, ''); const id = data.datapoint || clean(data.name); return !!String(data.name || '').trim() && !!id && globalData.tvconfigs.filter(entry => (entry.datapoint || clean(entry.name)) === id).length === 1",
              "validatorErrorText": "TV names must result in unique data points",
              "xs": 12,
              "sm": 6,
              "md": 8,
              "lg": 8,
              "xl": 8
            },
            {
              "type": "select",
              "title": "Programme source",
              "options": [
                {
                  "label": "TV für alle",
                  "value": "tvfueralle"
                },
                {
                  "label": "IPTV-EPG.org",
                  "value": "iptv-epg"
                }
              ],
              "default": "tvfueralle",
              "xs": 12,
              "sm": 6,
              "md": 8,
              "lg": 8,
              "xl": 8,
              "attr": "source"
            },
            {
              "type": "select",
              "title": "IPTV-EPG country",
              "xs": 12,
              "sm": 6,
              "md": 8,
              "lg": 8,
              "xl": 8,
