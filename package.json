{
  "name": "iobroker.tvprogram",
  "version": "5.0.1",
  "description": "This adapter polls information about the television program at regular intervals. The data can be displayed in various widgets",
  "author": {
    "name": "oweitman",
    "email": "oweitman@gmx.de"
  },
  "homepage": "https://github.com/oweitman/ioBroker.tvprogram",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "TV",
    "programm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oweitman/ioBroker.tvprogram"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.14.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1",
    "@types/proxyquire": "^1.3.31",
    "proxyquire": "^2.1.3",
    "typescript": "~5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|eslint.config.mjs|prettier.config.mjs).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "widgets/tvprogram.html",
    "widgets/tvprogram/css/*.css",
    "widgets/tvprogram/dist/*.js",
    "widgets/tvprogram/myi18n/*.json",
    "widgets/tvprogram/img/*.png",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"test/**/*.test.js\"",
    "test:js:ci": "npm ci --prefix widgets && npm run test:js",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:integration && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script --all",
    "npm": "npm i && cd widgets && npm i",
    "build": "npm run build:widgets",
    "build:widgets": "npm ci --prefix widgets && npm run build --prefix widgets",
    "dev:upload": "dev-server upload",
    "dev:run": "dev-server run",
    "dev:watch": "dev-server watch --noStart",
    "dev:watchvis1widgets": "npm run watch --prefix widgets",
    "repochecker": "npx @iobroker/repochecker https://github.com/oweitman/ioBroker.tvprogram --local --noinfo --env=../iobroker.env",
    "translate-admin": "node ./bin/translate.js -- source src-admin/src/i18n",
    "translate-widgets": "node ./bin/translate.js --source widgets/tvprogram/myi18n/en.json --format single"
  },
  "bugs": {
    "url": "https://github.com/oweitman/ioBroker.tvprogram/issues"
  },
  "readmeFilename": "README.md"
}
